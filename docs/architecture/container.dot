digraph G { rankdir=TB; graph [bgcolor="white", pad="0.22", nodesep="0.38", ranksep="0.45", fontname="DejaVu Sans", fontsize=15]; node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#456776", fillcolor="#eaf3f1", margin="0.16,0.11"]; edge [fontname="DejaVu Sans", fontsize=10, color="#48636f", fontcolor="#334e5c", arrowsize=.7];
u [label="Агроном / переглядач\n[Person]",fillcolor="#dce9fb"];

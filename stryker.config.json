
{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "logic.js"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test logic.test.js property.test.js"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 10000,
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  }
}

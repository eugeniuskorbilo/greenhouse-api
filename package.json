{
  "name": "greenhouse-api",
  "version": "1.0.0",
  "private": true,
  "description": "Greenhouse telemetry REST + MQTT + Socket.IO",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "subscriber": "node subscriber.js",
    "seed": "node seed.js",
    "test": "node --test logic.test.js integration.test.js api.test.js",
    "test:coverage": "node scripts/run-coverage.js",
    "test:e2e": "playwright test",
    "demo": "node scripts/publish.js",
    "seed:dashboard": "node scripts/seed_dashboard.js",
    "publish:dashboard": "node scripts/publish_dashboard.js",
    "seed:users": "node seed-users.js",
    "lint": "node --check server.js && node --check db.js && node --check auth/routes.js && node --check realtime/bridge.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "aedes": "^1.2.0",
    "fast-check": "^4.11.0"
  }
}
